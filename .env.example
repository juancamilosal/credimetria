# Copia este archivo como .env y pon el token del usuario "Lector web" de
# Directus (lee las tasas y solo puede crear prospectos). El .env no se sube
# al repositorio.
DIRECTUS_TOKEN=
# DIRECTUS_URL=https://credimetria-api.valkiriacode.com

# Correos de la asesoría (los mismos datos SMTP de los robots). Sin
# SMTP_HOST la solicitud se guarda igual y el correo solo sale en la consola.
SMTP_HOST=
SMTP_PUERTO=465
SMTP_USUARIO=
SMTP_CLAVE=
# A quién le llega el aviso de cada solicitud nueva.
AVISO_PARA=
# Remitente que ve el cliente (opcional; si no, el usuario SMTP).
# CORREO_DE=Credimetría <hola@credimetria.co>
# Dominio de la página para el logo y los enlaces del correo (opcional).
# SITIO_URL=https://credimetria.valkiriacode.com
